#version 460

[fragment]
out vec4 FragColor;

in vec4 Color;
in vec2 TexCoord;

uniform sampler2D texture0; // SDF atlas
uniform float smoothing;
uniform float spread;

void main()
{
  float dist = texture(texture0, TexCoord).a;
  float alpha = smoothstep(0.5 - smoothing, 0.5 + smoothing, dist);

  FragColor = vec4(Color.rgb, Color.a * alpha);
}

[vertex]
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec4 aColor;
layout (location = 2) in vec2 aTexCoord;
layout (location = 3) in vec2 aNormal; // Doesn't make sense in the 2D context

out vec4 Color;
out vec2 TexCoord;

uniform mat4 projection;
uniform mat4 model;
uniform mat4 view;

void main()
{
  gl_Position = projection * view * model * vec4(aPos, 1.0);

  Color = aColor;
  TexCoord = aTexCoord;
}
